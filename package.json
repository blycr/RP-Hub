{
  "name": "rphub",
  "version": "2.0.5",
  "private": true,
  "description": "Customized RP-Hub static site",
  "repository": {
    "type": "git",
    "url": "https://github.com/blycr/RP-Hub.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:static": "node scripts/build-static.mjs",
    "check:static": "node scripts/check-static.mjs",
    "test": "node --test gateway/worker.test.mjs tests/*.test.js",
    "test:mobile": "node tests/mobile-smoke.mjs",
    "verify": "npm run build:static && npm run check:static && npm test"
  },
  "devDependencies": {
    "daisyui": "4.7.2",
    "dompurify": "3.4.17",
    "localforage": "1.10.0",
    "marked": "18.1.2",
    "playwright-core": "1.58.2",
    "sortablejs": "1.15.7",
    "tailwindcss": "3.4.17",
    "vue": "3.5.44"
  }
}
